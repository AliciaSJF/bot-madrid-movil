# Copia este archivo a .env y rellénalo. .env NUNCA se sube al repo.

# Clave Fernet para cifrar las credenciales del portal en la base de datos.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# o, en la Pi sin Python: openssl rand -base64 32 | tr '+/' '-_'
# Si se pierde o se cambia, las contraseñas del portal guardadas no se pueden descifrar.
FERNET_KEY=

# Directorio de datos (base de datos SQLite y sesiones de Playwright por usuario)
DATA_DIR=./data

# Zona horaria de todo lo visible (en la BD se guarda UTC)
TZ=Europe/Madrid

# Por defecto nunca se confirma una reserva real
DRY_RUN=true

# Límites de respeto al portal
WATCH_MIN_INTERVAL_S=30
MAX_ACTIVE_WATCHES=3
# Segundos que una reserva sigue intentándolo tras la apertura si el portal va caído (60–3600)
BOOKING_WINDOW_S=600

# Navegador sin ventana (false para depurar en local)
HEADLESS=true

# Navegador instalado en vez del Chromium de Playwright. En Windows, si el antivirus
# bloquea el Chromium de Playwright al usar HEADLESS=false: BROWSER_CHANNEL=msedge
# Vacío en la Raspberry Pi.
BROWSER_CHANNEL=

# Telegram (hito 9)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
